# Wavelink: Docker Compose configuration. Copy to .env and fill in.
# (Running without Docker? Use service/.env.example and dashboard/.env.example instead.)

# Required. Shared secret between the service and the dashboard:  openssl rand -base64 24
MCP_TOKEN=
# Required. Signs dashboard login cookies, 16+ characters:         openssl rand -base64 32
AUTH_SECRET=

# Gemini API key (https://aistudio.google.com/apikey). Without it WhatsApp still syncs and sends,
# but transcripts, summaries, drafts and auto-replies are off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Notion (optional, see docs/notion.md). Redirect URI on the Notion connection: https://<DOMAIN>/api/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_SECRET_KEY=

# Public address of this install, used in OAuth metadata and shown on the dashboard.
#   with the https profile:  https://wa.example.com
#   local only:              http://localhost:3940
PUBLIC_URL=http://localhost:3940
# Domain for the https profile (Caddy gets a Let's Encrypt certificate for it)
DOMAIN=

# First start creates this superadmin. Leave the password empty to get one generated into the data volume
# (docker compose logs service shows where).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
OWNER_NAME=

LOCALE=en-US
TZ=UTC
