  "dependencies": {
    "@google/genai": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "openai": "^7.55.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
