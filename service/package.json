{
  "name": "wavelink-service",
  "version": "1.0.0",
  "description": "Wavelink service: WhatsApp connection, per-user SQLite store, OAuth 2.1 and the MCP server used by ChatGPT, Claude and other MCP clients",
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning mcp.js",
    "mcp": "npm start",
    "bot": "node --env-file-if-exists=.env bot.js",
    "test": "bash test/run.sh"
  },
