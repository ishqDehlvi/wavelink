# Wavelink service configuration. Copy to .env and fill in what you need.
# Every variable is optional unless marked required. See docs/configuration.md for details.

# --- AI (Gemini powers transcripts, image/PDF reading, summaries, drafts and auto-replies) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Server ---
# Where the service listens. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 inside Docker.
MCP_HOST=127.0.0.1
MCP_PORT=3940
# Public HTTPS address your AI app will reach, e.g. https://wa.example.com (required for ChatGPT/Claude connections)
PUBLIC_URL=
# Shared secret between the service and the dashboard. Generated into .mcp-token on first start if empty.
MCP_TOKEN=
# Where accounts, WhatsApp logins, messages and media are stored
DATA_DIR=./data

# --- First start: the superadmin account ---
DASHBOARD_USER=admin
# Leave empty to have a password generated into DATA_DIR/initial-admin-password.txt
DASHBOARD_PASSWORD=
OWNER_NAME=

# --- Notion (optional): one connection for the organisation, access set page by page in the dashboard ---
# From Notion's developer portal: an OAuth connection (Installable in: any workspace) with the capabilities
# Read/Update/Insert content and Read/Insert comments. Its redirect URI is PUBLIC_URL + /api/notion/callback.
# Without these, a superadmin can still paste an integration token on the Notion page.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Only if the dashboard lives on another address than PUBLIC_URL:
# NOTION_REDIRECT_URI=https://wa.example.com/api/notion/callback
# Encrypts the saved Notion token. If empty, one is generated into DATA_DIR/.notion-key on first start.
NOTION_SECRET_KEY=

# --- Demo mode: made-up chats for screenshots, recordings and trying Wavelink without a phone ---
# No WhatsApp connection is opened and nothing is really sent. `npm run demo` sets this for you (data in ./data-demo).
# DEMO_MODE=1

# --- Locale and time zone used when the AI is shown timestamps ---
LOCALE=en-US
TZ=UTC

# --- Standalone bot mode only (npm run bot): a WhatsApp number that answers with an LLM ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# ALLOWED_NUMBERS=
# GROUP_TRIGGER=@gpt
# SYSTEM_PROMPT=
# QR_PORT=3939
