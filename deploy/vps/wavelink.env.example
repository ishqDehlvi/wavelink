# Wavelink VPS settings, read by deploy/vps/setup.sh. Copy to wavelink.env (it is git-ignored).

# Required:  openssl rand -base64 24
MCP_TOKEN=
# Required:  openssl rand -base64 32
AUTH_SECRET=

# Gemini key for transcripts, summaries, drafts and auto-replies (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# First-start superadmin. Empty password = generated into service/data/initial-admin-password.txt
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
OWNER_NAME=

LOCALE=en-US
TZ=UTC
